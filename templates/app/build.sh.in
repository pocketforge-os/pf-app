#!/usr/bin/env bash
# build.sh — reproducible aarch64 build of {{APP_SLUG}}, driven from committed pins.
#
# Pipeline (all steps from THIS script; no manual manual):
#   1. Clone the pinned runtime (E2) + sim (E5) + platform (E1).
#   2. Cross-build libpocketforge.a for aarch64 in a stock rust container (staticlib).
#   3. Cross-build the sim's sdl3-render static libSDL3.a for aarch64 (VIDEO+software
#      render on; GPU/wayland/x11 off) — the off-hardware SDL3 the sim proof links.
#   4. Cross-compile build/{{APP_SLUG}}.arm64 (Makefile), static-linking both.
#
# Off-hardware only: the linked SDL3 is a stock software-render build for the sim. The
# on-device SDL3 (libSDL3-pocketforge.so.0, sunxifb/kmsdrm) is swapped in at LAUNCH via
# SDL3_DYNAMIC_API (see the `launch` shim) — never linked here.
#
# Requires: docker. The host aarch64-linux-gnu cross-gcc is used when present; when it is
# not (e.g. the headless pf-builder-vm CI lane) step 4 falls back to a container, same as
# pf-hwprobe's build.sh (bead tsp-u3e4). Run host: any docker host.
# ~5-10 min cold, ~30 s warm.
#
# Usage:
#   ./build.sh                 # build target: aarch64
#   ./build.sh --force-refetch # blow away caches under .cache/
#
# Artifact binding: every derived output records the pin it was built from
# (build/deps/.*-sha, build/.linked-pins); a pins.env bump invalidates the
# affected libraries and forces the final relink, and the cached source
# worktrees are reset+cleaned (ignored files included) exactly to their pins
# before consumption.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
cd "$HERE"

# GITHUB_WORKSPACE is the checkout; local dev runs fall back to the repo root, so
# every container bind source below stays anchored at the runner workspace root
# (host-route policy, tsp-ihne1.56.5).
: "${GITHUB_WORKSPACE:=$HERE}"

# shellcheck disable=SC1091
source "$HERE/pins.env"

CACHE_DIR="${CACHE_DIR:-${GITHUB_WORKSPACE}/.cache}"
BUILD_DIR="${BUILD_DIR:-${GITHUB_WORKSPACE}/build}"
DEPS_DIR="$BUILD_DIR/deps"
RUNTIME_SRC="$CACHE_DIR/runtime"
SIM_SRC="$CACHE_DIR/sim"
PLATFORM_SRC="$CACHE_DIR/platform"

# The docker steps bind the literal ${GITHUB_WORKSPACE}/... paths below; an
# override that resolves elsewhere cannot be a workspace-anchored bind, so fail
# loudly instead of silently widening the host-route policy.
if [ "$CACHE_DIR" != "${GITHUB_WORKSPACE}/.cache" ] || [ "$BUILD_DIR" != "${GITHUB_WORKSPACE}/build" ]; then
    printf 'build.sh: CACHE_DIR/BUILD_DIR must resolve to ${GITHUB_WORKSPACE}/.cache and ${GITHUB_WORKSPACE}/build (host-route policy: container bind sources are workspace-anchored)\n' >&2
    exit 2
fi

force_refetch=0
for arg in "$@"; do
    case "$arg" in
        --force-refetch) force_refetch=1 ;;
        -h|--help) sed -n '2,25p' "$0"; exit 0 ;;
    esac
done

mkdir -p "$CACHE_DIR" "$BUILD_DIR" "$DEPS_DIR"
banner() { printf '\n==== %s ====\n' "$*"; }

clone_pin() {  # $1=repo $2=commit $3=dest
    local repo="$1" commit="$2" dest="$3"
    if [ "$force_refetch" = 1 ]; then rm -rf "$dest"; fi
    if [ ! -d "$dest/.git" ]; then
        banner "clone $(basename "$dest") @ $commit"
        git clone --quiet "$repo" "$dest"
    fi
    # Bind the cached worktree EXACTLY to the pin: a plain checkout would keep
    # tracked edits made at an earlier commit, untracked leftovers or IGNORED
    # leftovers (-ffd keeps ignored files; -ffdx does not), any of which could
    # enter the runtime library, the SDL build or the sim image.
    (cd "$dest" && git fetch --quiet --tags origin \
        && git reset --hard --quiet "$commit" \
        && git clean --quiet -ffdx \
        && git -c advice.detachedHead=false checkout --quiet "$commit")
    (cd "$dest" && git rev-parse HEAD)
}

# ------------------------------------------------------------------ 1. sources
clone_pin "$RUNTIME_REPO"  "$RUNTIME_COMMIT"  "$RUNTIME_SRC"  > "$BUILD_DIR/runtime.sha"
clone_pin "$SIM_REPO"      "$SIM_COMMIT"      "$SIM_SRC"      > "$BUILD_DIR/sim.sha"
clone_pin "$PLATFORM_REPO" "$PLATFORM_COMMIT" "$PLATFORM_SRC" > "$BUILD_DIR/platform.sha"

# Derived artifacts are KEYED to the pins they were built from: each records the
# input commit in a stamp file next to it, and a pin bump invalidates the
# artifact (and forces the final relink) instead of silently reusing the stale
# output of an earlier pin. --force-refetch invalidates everything.
RUNTIME_STAMP="$DEPS_DIR/.libpocketforge.runtime-sha"
SIM_STAMP="$DEPS_DIR/.libSDL3.sim-sha"
PINS_STAMP="$BUILD_DIR/.linked-pins"
stamp_matches() {  # $1=stamp file $2=expected content
    [ -f "$1" ] && [ "$(cat "$1")" = "$2" ]
}
current_pins="$RUNTIME_COMMIT $SIM_COMMIT $PLATFORM_COMMIT"
if [ "$force_refetch" = 1 ] || ! stamp_matches "$PINS_STAMP" "$current_pins"; then
    # Any pin drift (or a cold tree) forces the final link: make may otherwise
    # keep an existing build/{{APP_SLUG}}.arm64 when the reused-or-rebuilt
    # library timestamps do not happen to be newer.
    rm -f "$BUILD_DIR/{{APP_SLUG}}.arm64"
fi

# ------------------------------------------------------------------ 2. libpocketforge.a (cross-Rust)
LIBPF_A="$DEPS_DIR/libpocketforge.a"
if [ ! -f "$LIBPF_A" ] || [ "$force_refetch" = 1 ] \
   || ! stamp_matches "$RUNTIME_STAMP" "$RUNTIME_COMMIT"; then
    banner "cross-build libpocketforge.a (aarch64-unknown-linux-gnu, staticlib)"
    # Ownership hand-back (bead tsp-u3e4): the container runs as root (apt/rustup
    # need it), so anything it writes to /out lands root-owned on the HOST bind
    # mount — which wedged the build-lab runner workdir (actions/checkout EACCES
    # rmdir on stale root-owned deps). The final chown expands $(id -u):$(id -g)
    # RUNNER-SIDE inside the container script argument; no dynamic docker env
    # value is passed (the canonical host-route policy fails closed on those),
    # and `--` ends option parsing before the dynamic "$RUST_IMAGE" operand.
    # ./build.sh never leaves files its caller can't delete.
    docker run --rm \
        -v "${GITHUB_WORKSPACE}/.cache/runtime":/src:ro \
        -v "${GITHUB_WORKSPACE}/build/deps":/out \
        -e CARGO_HOME=/tmp/cargo \
        -- "$RUST_IMAGE" bash -euxc '
            mkdir -p /work && cp -a /src/. /work/
            cd /work
            apt-get update -qq
            apt-get install -y -qq --no-install-recommends gcc-aarch64-linux-gnu libc6-dev-arm64-cross >/dev/null
            rustup target add aarch64-unknown-linux-gnu >/dev/null
            mkdir -p .cargo
            cat > .cargo/config.toml <<EOF
[target.aarch64-unknown-linux-gnu]
linker = "aarch64-linux-gnu-gcc"
EOF
            cargo build --release -p libpocketforge --target aarch64-unknown-linux-gnu
            cp target/aarch64-unknown-linux-gnu/release/libpocketforge.a /out/libpocketforge.a
            aarch64-linux-gnu-nm --defined-only /out/libpocketforge.a | grep -E "\\bT pf_" | wc -l
            chown -R '"$(id -u):$(id -g)"' /out
        '
    echo "libpocketforge.a: $(file "$LIBPF_A")"
    echo "$RUNTIME_COMMIT" > "$RUNTIME_STAMP"
fi
mkdir -p "$DEPS_DIR/include"
cp -f "$RUNTIME_SRC/include/pocketforge.h" "$DEPS_DIR/include/pocketforge.h"

# ------------------------------------------------------------------ 3. libSDL3.a (arm64 render static)
SDL3_A="$DEPS_DIR/libSDL3.a"
SDL3_INC="$DEPS_DIR/sdl3-include"
if [ ! -f "$SDL3_A" ] || [ "$force_refetch" = 1 ] \
   || ! stamp_matches "$SIM_STAMP" "$SIM_COMMIT"; then
    banner "cross-build SDL3 arm64 static (sim's fb/render recipe)"
    # Drop the previous header tree so no stale header from an earlier SIM pin
    # survives the overwrite-copy below (find-delete pattern, house rule).
    if [ -d "$SDL3_INC" ]; then find "$SDL3_INC" -mindepth 1 -delete; fi
    # Same ownership hand-back as the rust container above (bead tsp-u3e4).
    docker run --rm \
        -v "${GITHUB_WORKSPACE}/.cache/sim":/sim:ro \
        -v "${GITHUB_WORKSPACE}/build/deps":/out \
        -w /work \
        debian:bookworm bash -euxc '
            apt-get update -qq
            apt-get install -y -qq --no-install-recommends \
                git ca-certificates cmake ninja-build gcc g++ \
                gcc-aarch64-linux-gnu g++-aarch64-linux-gnu libc6-dev-arm64-cross \
                file >/dev/null
            cp -a /sim/sdl3 sdl3
            cp -a /sim/fb   fb
            OUT=/work/sdl3-render SRC=/work/sdl3-src bash fb/build-sdl3-render.sh
            cp /work/sdl3-render/arm64/lib/libSDL3.a /out/libSDL3.a
            mkdir -p /out/sdl3-include
            cp -a /work/sdl3-render/arm64/include/. /out/sdl3-include/
            chown -R '"$(id -u):$(id -g)"' /out
        '
    echo "libSDL3.a: $(file "$SDL3_A")"
    echo "$SIM_COMMIT" > "$SIM_STAMP"
fi

# ------------------------------------------------------------------ 4. {{APP_SLUG}}.arm64
banner "cross-compile {{APP_SLUG}} (aarch64-linux-gnu-gcc)"
if command -v aarch64-linux-gnu-gcc >/dev/null 2>&1; then
    # Native fast path — the host has the cross-gcc (typical dev machine).
    export CC=aarch64-linux-gnu-gcc
    export SDL3_INCLUDE="$SDL3_INC"
    export PF_INCLUDE="$DEPS_DIR/include"
    export SDL3_STATIC="$SDL3_A"
    export PF_STATIC="$LIBPF_A"
    export OUT_DIR="$BUILD_DIR"
    export BIN_NAME="{{APP_SLUG}}.arm64"
    make -f Makefile all
else
    # Container fallback (ported from pf-hwprobe's build.sh, bead tsp-u3e4): the
    # headless CI builder VMs carry no cross-gcc — `make` dies with
    # `aarch64-linux-gnu-gcc: No such file or directory`. Same hermetic pattern as
    # steps 2/3, same ownership hand-back so nothing root-owned lands in the workdir.
    # The double mount keeps an overridden BUILD_DIR working: the container always
    # sees the build tree at /work/build.
    docker run --rm \
        -v "${GITHUB_WORKSPACE}":/work -w /work \
        -v "${GITHUB_WORKSPACE}/build":/work/build \
        debian:bookworm bash -euxc '
            apt-get update -qq
            apt-get install -y -qq --no-install-recommends \
                make file gcc-aarch64-linux-gnu libc6-dev-arm64-cross >/dev/null
            export CC=aarch64-linux-gnu-gcc
            export SDL3_INCLUDE=/work/build/deps/sdl3-include
            export PF_INCLUDE=/work/build/deps/include
            export SDL3_STATIC=/work/build/deps/libSDL3.a
            export PF_STATIC=/work/build/deps/libpocketforge.a
            export OUT_DIR=/work/build
            export BIN_NAME={{APP_SLUG}}.arm64
            make -f Makefile all
            chown -R '"$(id -u):$(id -g)"' /work/build
        '
fi
file "$BUILD_DIR/{{APP_SLUG}}.arm64"
echo "$current_pins" > "$PINS_STAMP"

banner "build ok"
printf '   binary: %s\n' "$BUILD_DIR/{{APP_SLUG}}.arm64"
printf '   runtime commit: %s\n' "$(cat "$BUILD_DIR/runtime.sha")"
printf '   sim commit (SDL3): %s\n' "$(cat "$BUILD_DIR/sim.sha")"
